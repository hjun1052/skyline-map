{
  "name": "skyline-atlas",
  "version": "1.0.0",
  "description": "Google-Maps-style viewer for Cities: Skylines CSLMapView exports",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "check": "tsx src/geo.check.ts && tsx src/context.check.ts && tsx src/findfile.check.ts",
    "check:oneway": "tsx tools/oneway-check.ts",
    "deploy": "npm run build && wrangler deploy",
    "check:access": "tsx tools/access-check.ts",
    "check:districts": "tsx tools/district-check.ts",
    "check:transit": "tsx tools/transit-check.ts",
    "check:reach": "tsx tools/reach-check.ts",
    "check:history": "tsx tools/history-check.ts",
    "check:discover": "tsx tools/discover-check.ts",
    "check:closure": "tsx tools/closure-check.ts",
    "check:schematic": "tsx tools/schematic-check.ts",
    "check:i18n": "tsx tools/i18n-check.ts",
    "check:tolls": "tsx tools/toll-check.ts",
    "check:groups": "tsx tools/group-check.ts",
    "check:route-geometry": "tsx tools/route-geometry-check.ts",
    "check:nav": "tsx tools/nav-check.ts",
    "check:sim": "tsx tools/sim-check.ts",
    "check:data": "node tools/check-sample.mjs",
    "check:vellummap": "tsx tools/vellummap-check.ts",
    "check:vellum-routes": "tsx tools/vellum-route-check.ts",
    "check:vellum-sim": "tsx tools/vellum-sim-check.ts",
    "check:traffic-dir": "tsx tools/traffic-dir-check.ts",
    "lane-catalog": "tsx tools/lane-catalog.ts"
  },
  "author": "",
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "maplibre-gl": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pretendard": "^1.3.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hjun1052/skyline-map.git"
  },
  "homepage": "https://skyline.codz.me"
}
